# Copy to .env and fill in.

# Organisers' temporary API: paste the "Открыть GET для DEV" link from the guide (p.3).
# The app substitutes group_id per import (DEV, or the control-set id announced at hour 23).
CQA_API_URL=

# Evaluator. With an API key -> Claude; without -> offline MOCK evaluator (UI testing only).
ANTHROPIC_API_KEY=
CQA_MODEL=claude-opus-5-5
CQA_EFFORT=medium                # low | medium | high | xhigh | max
EVAL_CONCURRENCY=4               # parallel evaluations


# Team Qwen model served from Google Colab: run colab/CQA_qwen_server.ipynb there and click the printed
# link — it connects the site at runtime (saved in backend/data). QWEN_URL/QWEN_TOKEN here are only a fallback.
EVALUATOR=qwen                   # qwen | anthropic | mock | auto
QWEN_URL=
QWEN_TOKEN=
QWEN_RUNS=1                      # 3 = sampled runs + majority vote (3x slower)
